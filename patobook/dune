(rule
 (targets patobook.pdf)
 (deps
  patobook.txp
  Introduction.txp
  FirstDocuments.txp
  PatoMaths.txp
  Programming.txp
  Drawings.txp
  Typesetting.txp
  Extending.txp
  Editors.txp
  pato.png
  titlepato.png)
 (action
  (progn
   (system "patoline --driver Pdf --format FormatThese --extra-fonts-dir ../fonts --extra-hyph-dir ../hyphs -o patobook.pdf patobook.txp || echo patoline not available, patobook.pdf stubbed")
   (with-stdout-to patobook.pdf (echo "stub: patobook.pdf would be generated by patoline")))))
