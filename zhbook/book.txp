(* #FORMAT FormatZhBook *)

\Caml(
  (* ---- Title page (P5) ------------------------------------------- *)
  (* A horizontal rule of the given width and thickness (mm).  Rules
     must be *stroked*: an open path with only a fill colour has zero
     area and renders nothing. *)
  let rule width thickness () =
    [ bB (fun _ ->
        let w = width in
        let h = max thickness 0.05 in
        [ Drawing
            { drawing_min_width = w;
              drawing_max_width = w;
              drawing_width_fixed = true;
              drawing_adjust_before = false;
              drawing_y0 = 0.;
              drawing_y1 = h;
              drawing_nominal_width = w;
              drawing_contents =
                (fun _ ->
                  [ RawContent.Path
                      ( { RawContent.default_path_param with
                          RawContent.lineWidth = h;
                          RawContent.fillColor = None;
                          RawContent.strokingColor = Some Color.black },
                        [ [| [| 0.; w |], [| h /. 2.; h /. 2. |] |] ]) ]);
              drawing_break_badness = 0.;
              drawing_states = [];
              drawing_badness = (fun _ -> 0.) } ]) ]

  let centered c =
    [ envOf (fun env -> { env with par_indent = [] });
      C (fun env ->
        let m = env.normalMeasure in
        let boxes = boxify_scoped env c in
        let w =
          List.fold_left
            (fun w b -> let _, a, _ = Box.box_interval b in w +. a)
            0. boxes
        in
        let left = (m -. w) /. 2. in
        let right = m -. w -. left in
        bB (fun _ -> [glue left left left])
        :: c
        @ [bB (fun _ -> [glue right right right])]) ]

  (* Figure with 图 caption; [name] becomes a cross-reference label.
     [figure] returns content (and performs the structure insert as a
     side effect), which is what the [zh_figure_test] macro below
     needs. *)
  let zh_figure ?(width = 60.0) ?(name = "") path caption =
    figure ~name:name ~caption:[tT caption]
      (fun env -> Typography.Document.image ~width:width path env)

  (* One table cell holding a full-width horizontal rule.  Table cells
     are document structures (the format's [table] maps minipages over
     them), hence the [paragraph] wrapper. *)
  let ruleCell () =
    paragraph ~par_env:(fun x -> { x with par_indent = [] })
      [ bB (fun env ->
            let w = env.normalMeasure in
            [ Drawing
                { drawing_min_width = w;
                  drawing_max_width = w;
                  drawing_width_fixed = true;
                  drawing_adjust_before = false;
                  drawing_y0 = 0.;
                  drawing_y1 = 0.2;
                  drawing_nominal_width = w;
                  drawing_contents =
                    (fun _ ->
                      [ RawContent.Path
                          ( { RawContent.default_path_param with
                              RawContent.lineWidth = 0.15;
                              RawContent.fillColor = None;
                              RawContent.strokingColor = Some Color.black },
                            [ [| [| 0.; w |], [| 0.1; 0.1 |] |] ]) ]);
                  drawing_break_badness = 0.;
                  drawing_states = [];
                  drawing_badness = (fun _ -> 0.) } ]) ]

  let ruleRow cols = Array.init cols (fun _ -> ruleCell ())

  let zh_table cols rows =
    let params =
      { widths =
          (fun env ->
            Array.make cols (env.normalMeasure /. float_of_int cols));
        h_spacing = 5.0;
        v_spacing = 0.8 }
    in
    table params rows

  (* Attachment page: full-width image, centred (paren macro args
     cannot carry leading ~labels, so the application lives here). *)
  let attachment path =
    D.structure :=
      newPar !D.structure
        ~environment:(fun e -> { e with par_indent = [] })
        Complete.normal center
        (includeGraphics ~width:150.0 path);
    []

  let put_table cols rows =
    D.structure :=
      newPar !D.structure
        ~environment:(fun e -> { e with par_indent = [] })
        Complete.normal center (zh_table cols rows)
)

\Caml(
  let tp_rule thickness gap =
    (vspaceBefore gap) @ centered (rule 130. thickness ())

  (* Double rule as on the reference title page: [h1] on top, [h2]
     below it, [sep] millimetres apart, all drawn as one box so the
     pair stays tight. *)
  let tp_rules h1 h2 sep gap =
    (vspaceBefore gap)
    @ centered
        [ bB (fun _ ->
              let w = 130. in
              let hh = h1 +. sep +. h2 in
              [ Drawing
                  { drawing_min_width = w;
                    drawing_max_width = w;
                    drawing_width_fixed = true;
                    drawing_adjust_before = false;
                    drawing_y0 = 0.;
                    drawing_y1 = hh;
                    drawing_nominal_width = w;
                    drawing_contents =
                      (fun _ ->
                        [ RawContent.Path
                            ( { RawContent.default_path_param with
                                RawContent.lineWidth = h1;
                                RawContent.fillColor = None;
                                RawContent.strokingColor = Some Color.black },
                              [ [| [| 0.; w |], [| h1 /. 2.; h1 /. 2. |] |] ]);
                          RawContent.Path
                            ( { RawContent.default_path_param with
                                RawContent.lineWidth = h2;
                                RawContent.fillColor = None;
                                RawContent.strokingColor = Some Color.black },
                              [ [| [| 0.; w |],
                                  [| h1 +. sep +. h2 /. 2.;
                                     h1 +. sep +. h2 /. 2. |] |] ]) ]);
                    drawing_break_badness = 0.;
                    drawing_states = [];
                    drawing_badness = (fun _ -> 0.) } ]) ]

  let small c =
    [envOf (fun (env : Typography.Document.environment) ->
        { env with size = env.size *. 0.87 })]
    @ c

  let tp_text scale gap s =
    (vspaceBefore gap)
    @ centered ([envOf (fun (env : Typography.Document.environment) ->
          { env with size = env.size *. scale })] @ [tT s])

  let tp_footer gap s =
    (vspaceBefore gap) @ centered (small [tT s])
)

\tp_rules(0.71)(0.24)(0.47)(13.29)

\tp_text(2.4)(2.71)("Patoline")

\tp_text(2.5)(8.58)("中文书籍模板")

\tp_rules(0.20)(0.58)(0.59)(4.01)

\tp_text(1.14)(10.4)("作者：NELSON CHEUNG")

\tp_text(1.0)(4.88)("ZHANGJUNYU@NELSON-CHEUNG.CN")

\tp_footer(99.5)("如果你有任何问题或评论，")

\tp_footer(1.9)("可以通过邮件 ZHANGJUNYU@NELSON-CHEUNG.CN 联系我")

\tp_footer(2.8)("Happy Patoline-ing!")

